# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devmetrics?retryWrites=true&w=majority

# Security & Cryptography Secrets (Change in production!)
JWT_SECRET=your_long_random_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_long_random_cookie_secret_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
INGEST_RATE_LIMIT_MAX=300
